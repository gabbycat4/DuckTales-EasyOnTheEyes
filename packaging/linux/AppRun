#!/bin/sh
# DuckTales Recompiled AppImage entry point.
#
# The game keeps config.ini and its save states beside its program, and an
# AppImage is read-only. So the program is copied once per version into the
# folder the game already uses for your ROM and mods,
# ~/.local/share/DuckTales Recompiled, and run from there; your settings and
# saves in that folder are kept across updates.
HERE="$(dirname "$(readlink -f "$0")")"
DATA="${DUCKTALES_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/DuckTales Recompiled}"
VERSION="$(cat "$HERE/VERSION")"

if [ "$(cat "$DATA/VERSION" 2>/dev/null)" != "$VERSION" ] || [ ! -x "$DATA/bin/ducktales" ]; then
    mkdir -p "$DATA/bin" || exit 1
    rm -rf "$DATA/lib"
    mkdir -p "$DATA/lib" || exit 1
    if [ -d "$HERE/usr/lib" ]; then
        cp -R "$HERE/usr/lib/." "$DATA/lib/" || exit 1
    fi
    cp -f "$HERE/usr/bin/ducktales" "$DATA/bin/ducktales.new" &&
    mv -f "$DATA/bin/ducktales.new" "$DATA/bin/ducktales" &&
    cp -f "$HERE/VERSION" "$DATA/VERSION" || exit 1
fi

cd "$DATA/bin" || exit 1
exec "$DATA/bin/ducktales" "$@"
